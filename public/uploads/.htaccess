# Archivos subidos por usuarios: NUNCA ejecutar código desde esta carpeta.
# En un hosting PHP, un archivo .php subido acá se ejecutaría en el servidor.
# La app ya valida las extensiones al subir (App\Support\Uploads); esto es una
# segunda barrera por si algo se cuela.

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|shtml|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>
